[Unit]
Description=Stock bot Telegram listener (talk to Grok, Gemini, Claude)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python listener.py
Restart=always
RestartSec=10
# jobs started from Telegram (/analyse) keep running if the listener restarts
KillMode=process
Nice=5

[Install]
WantedBy=multi-user.target
