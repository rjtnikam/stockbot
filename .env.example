# Copy this file to .env, fill in your own values, then: chmod 600 .env
# Never commit .env or share it: these keys spend your money and reach your Telegram.
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
XAI_API_KEY=your_xai_key
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_BotFather
TELEGRAM_CHAT_ID=your_own_chat_id
# Optional model overrides (defaults are in the code):
# CLAUDE_MODEL= CLAUDE_CHAT_MODEL= CLAUDE_FAST_MODEL= GEMINI_MODEL= GEMINI_DEEP_MODEL= GROK_MODEL=
# Screener / MarketSmith logins: run login_local.py on your own computer; it writes session.json (never share it).
